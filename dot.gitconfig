[include]
    path = ~/dotfiles/delta/themes.gitconfig
[alias]
        co = checkout
	logf = log -1 --stat
        b = checkout -b
        merges = merge --squash
    rhead = reset --hard HEAD
    whereis = branch -a --contains
[core]
    excludesfile = ~/gitignore
    autocrlf = input
    pager = delta
[interactive]
    diffFilter = delta --color-only
[user]
	name = Evan Moses
	email = evan@emoses.org
[diff]
    colorMoved = default
    algorithm = histogram
[merge]
     conflictstyle = zdiff3
[delta]
    navigate = true
    light = false
    side-by-side = true
    features = chameleon default magit-delta tomorrow-night-diff
[delta "default"]
    line-numbers = true
[delta "magit-delta"]
    line-numbers = false
[delta "tomorrow-night-diff"]
    # Diff colors tuned for sanityinc-tomorrow-night (bg #1d1f21)
    # removed lines: dark muted red background, keep syntax-colored code
    minus-style              = syntax "#3f2025"
    minus-emph-style         = normal "#7a2f39"
    minus-non-emph-style     = minus-style
    # added lines: dark muted green background, keep syntax-colored code
    plus-style = syntax "#21d966"
    #plus-style               = syntax "#1d3a28"
    plus-emph-style          = normal "#2f6b46"
    plus-non-emph-style      = plus-style
    # line-number gutter to match
    line-numbers-minus-style = "#cc6666"
    line-numbers-plus-style  = "#b5bd68"
    zero-style               = syntax

[color]
        status = auto
        diff = auto
        branch = auto
        interactive = auto
        ui = true
[difftool]
	prompt = true
[credential]
	useHttpPath = true
[push]
	default = simple
[github "github-emoses"]
	user = emoses
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	required = true
	process = git-lfs filter-process
[color "diff-highlight"]
	oldNormal = red bold
    oldHighlight = red bold 52
    newNormal = green bold
    newHighlight = green bold 22
[github]
	user = emoses
[sendemail]
        smptEncryption = tls
        smptServer = smtp.gmail.com
        smtpUser = evan@emoses.org
        smtpServerPort = 587
	annotate = yes
[url "git@github.com-emoses:emoses"]
     insteadOf = https://github.com/emoses
[git-link]
    branch = master
[init]
	defaultBranch = main
[rerere]
	enabled = true
[pull]
	rebase = false
[http]
	postBuffer = 523288000
[branch]
	autosetupmerge = always
[include]
    # Add local overrides here.  If this doesn't exist git will ignore
    path = ~/.local/git.config
[includeIf "gitdir:~/dev/github.com/emoses/"]
    path = ~/.gitconfig.personal
[includeIf "gitdir:~/dotfiles/"]
    path = ~/.gitconfig.personal
